# Copy this file to keystore.properties (same directory) and fill in the real
# passwords used for the Flutter app's release keystore
# (smart-home-app/android/key.properties). Reusing the same keystore/alias is
# required so this native app can be installed as an update over the existing
# Flutter "Smart Home" app (same applicationId + same signing certificate).
#
# storeFile is resolved relative to this file's location (the project root).
storeFile=../smart-home-app/MyAndroidKeyStore.jks
keyAlias=smart_home_app
storePassword=
keyPassword=
