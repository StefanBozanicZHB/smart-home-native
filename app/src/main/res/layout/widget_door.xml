<?xml version="1.0" encoding="utf-8"?>
<!-- 1x1 home screen button that opens the front door (widget/DoorWidget.kt). Static: never redrawn. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/door_button"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp"
    android:contentDescription="@string/door_widget_action">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:background="@drawable/widget_door_background"
        android:padding="12dp"
        android:src="@drawable/ic_door_widget"
        android:importantForAccessibility="no" />
</FrameLayout>
