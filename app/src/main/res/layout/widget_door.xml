<?xml version="1.0" encoding="utf-8"?>
<!-- 1x1 home screen button that opens the front door (widget/DoorWidget.kt). Static: never redrawn by
     the app; the pressed look comes from state drawables the launcher draws. Only the disc reacts, not
     the empty corners of the cell. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/door_button"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:background="@drawable/widget_door_background"
        android:padding="14dp"
        android:src="@drawable/widget_door_icon"
        android:contentDescription="@string/door_widget_action" />
</FrameLayout>
