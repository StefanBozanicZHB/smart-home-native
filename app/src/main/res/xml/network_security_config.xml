<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 7.0 (the wall tablet, API 24) does not ship the Let's Encrypt roots, so HTTPS to sites with
  a Let's Encrypt certificate (the Open-Meteo forecast) fails there. These two public roots are
  trusted in addition to the system ones; nothing else changes (no cleartext, no user CAs).
  ISRG Root X1 SHA-256 96:BC:EC:06:26:49:76:F3:74:60:77:9A:CF:28:C5:A7:CF:E8:A3:C0:AA:E1:1A:8F:FC:EE:05:C0:BD:DF:08:C6
  ISRG Root X2 SHA-256 69:72:9B:8E:15:A8:6E:FC:17:7A:57:AF:B7:17:1D:FC:64:AD:D2:8C:2F:CA:8C:F1:50:7E:34:45:3C:CB:14:70
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/isrg_root_x2" />
        </trust-anchors>
    </base-config>
</network-security-config>
