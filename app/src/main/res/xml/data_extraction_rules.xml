<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. The preferences hold the sign-in session (encrypted with a Keystore key
     that does not move to another phone): left out of cloud backup and of a transfer to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/smart_home_prefs.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/smart_home_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
